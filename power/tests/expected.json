  "not_in_the_fixture": {
    "note": "The sprint plan matrix has no expected values: wp_expected.json predates it and the generator does not emit the Sprint plan sheet. Check these by hand against the React app's Timeline page for the same seed, and hold them to the three identities below, which do follow from the fixture.",
    "identities": [
      "Sum(Ungroup(SprintPlan, \"Value\"), Available) equals the quarter's available MW, which is SprintPlanGrand.Available, and must sit within 0.5 MW of NetTotal plus the Team level squad's net; capacity spreads by working days, so the two agree only to the rounding of the sprint boundaries.",
      "SprintPlanGrand.Committed is demand spread evenly per sprint, not day-weighted, so it does NOT equal CommittedTotal (87.1181). Expect it to be larger where a span runs past the quarter. Record the figure the first time it is built and treat that as the baseline.",
      "Sum over the squads of SprintPlanSquadTotal(name).Reserved equals ReservedTotal (38.78) to within 0.01, because the sprint shares sum to one."
    ],
    "marker": "Any cell with committed work and no availability must read Utilisation = 9.99 and show the words \"No capacity\"."
  }
